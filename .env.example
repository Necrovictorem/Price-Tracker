# Copy to .env and fill in from https://developer.ebay.com (Production keyset)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Set to "sandbox" while testing sandbox keys; leave as "production" (or omit) for live keys.
EBAY_ENV=production

# Currently unused — Reddit declined the Data API access request (2026-11-04).
# See src/price_tracker/collectors/reddit.py and cli.py. Leave blank for now.
# Register an app at https://www.reddit.com/prefs/apps ("script" or "web app" type)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit requires a descriptive User-Agent identifying the app and you, e.g.:
# price-tracker/0.1 by u/yourname
REDDIT_USER_AGENT=

# Optional: push alerts (buy-target, sharp-drop, new-low) through ntfy
# (https://ntfy.sh). Leave blank to skip alerts -- the tracker still runs
# and logs prices either way.
# Pick a private, hard-to-guess topic name: anyone who knows it can read
# your alerts, or publish fake ones, on the public ntfy.sh server.
# Subscribe to the same topic in the ntfy app to receive it on your phone.
NTFY_TOPIC=
# Only needed if you run your own ntfy server instead of ntfy.sh.
NTFY_SERVER=https://ntfy.sh
