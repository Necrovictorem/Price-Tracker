# Copy to .env and fill in from https://developer.ebay.com (Production keyset)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Set to "sandbox" while testing sandbox keys; leave as "production" (or omit) for live keys.
EBAY_ENV=production

# Currently unused — Reddit declined the Data API access request (2026-11-04).
# See src/price_tracker/collectors/reddit.py and cli.py. Leave blank for now.
# Register an app at https://www.reddit.com/prefs/apps ("script" or "web app" type)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit requires a descriptive User-Agent identifying the app and you, e.g.:
# price-tracker/0.1 by u/yourname
REDDIT_USER_AGENT=
